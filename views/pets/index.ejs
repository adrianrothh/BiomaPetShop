<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pets - Bioma Pet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>

  <%- include('../partials/sidebar') %>

  <main class="main-content">

    <div class="page-header">
      <div>
        <div class="page-title"><i class="bi bi-heart-fill"></i> Pets</div>
        <div class="page-subtitle">Gerencie os pets cadastrados</div>
      </div>
      <button class="btn-primary-action" data-bs-toggle="modal" data-bs-target="#modalNovoPet">
        <i class="bi bi-plus-lg"></i> Novo Pet
      </button>
    </div>

    <div class="section-card">
      <div class="search-bar">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Buscar pet por nome, espécie ou raça..." id="busca-pet">
      </div>

      <table class="table-agendamentos" id="tabela-pets">
        <thead>
          <tr>
            <th>#</th>
            <th>Nome</th>
            <th>Espécie</th>
            <th>Raça</th>
            <th>Porte</th>
            <th>Tutor</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (pets.length === 0) { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <i class="bi bi-heart"></i>
                  Nenhum pet cadastrado ainda.
                </div>
              </td>
            </tr>
          <% } else { %>
            <% pets.forEach(function(p, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><strong><%= p.nome %></strong></td>
                <td><%= p.especie === 'cao' ? '🐶 Cão' : p.especie === 'gato' ? '🐱 Gato' : '🐾 ' + p.especie %></td>
                <td><%= p.raca || '-' %></td>
                <td><%= p.porte || '-' %></td>
                <td><%= p.cliente_nome || '-' %></td>
                <td class="acoes">
                  <button class="btn-acao editar" title="Editar" onclick="abrirEditar(<%= JSON.stringify({id: p.id, nome: p.nome, especie: p.especie, raca: p.raca || '', porte: p.porte || '', cliente_id: p.cliente_id || ''}) %>)"><i class="bi bi-pencil-fill"></i></button>
                  <button class="btn-acao excluir" title="Excluir" onclick="excluir('/pets/<%= p.id %>')"><i class="bi bi-trash-fill"></i></button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>

    </div>

  </main>

  <!-- Modal Novo Pet -->
  <div class="modal fade" id="modalNovoPet" tabindex="-1" aria-labelledby="modalNovoPetLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalNovoPetLabel"><i class="bi bi-heart-fill me-2"></i>Novo Pet</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div id="novo-erro-pet" class="alert alert-danger d-none"></div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Nome <span class="text-danger">*</span></label>
            <input type="text" id="novo-nome-pet" class="form-control" placeholder="Nome do pet">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Espécie <span class="text-danger">*</span></label>
            <select id="novo-especie-pet" class="form-select">
              <option value="">Selecione...</option>
              <option value="cao">🐶 Cão</option>
              <option value="gato">🐱 Gato</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Raça <span class="text-danger">*</span></label>
            <input type="text" id="novo-raca-pet" class="form-control" placeholder="Ex: Labrador, Poodle...">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Porte <span class="text-danger">*</span></label>
            <select id="novo-porte-pet" class="form-select">
              <option value="">Selecione...</option>
              <option value="Pequeno">Pequeno</option>
              <option value="Médio">Médio</option>
              <option value="Grande">Grande</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Tutor (Cliente) <span class="text-danger">*</span></label>
            <select id="novo-cliente-pet" class="form-select">
              <option value="">Selecione...</option>
              <% clientes.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.nome %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-success" onclick="cadastrarPet()">Cadastrar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Editar Pet -->
  <div class="modal fade" id="modalEditarPet" tabindex="-1" aria-labelledby="modalEditarPetLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalEditarPetLabel"><i class="bi bi-pencil-fill me-2"></i>Editar Pet</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div id="edit-erro-pet" class="alert alert-danger d-none"></div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Nome <span class="text-danger">*</span></label>
            <input type="text" id="edit-nome" class="form-control" placeholder="Nome do pet" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Espécie <span class="text-danger">*</span></label>
            <select id="edit-especie" class="form-select" required>
              <option value="">Selecione...</option>
              <option value="cao">🐶 Cão</option>
              <option value="gato">🐱 Gato</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Raça <span class="text-danger">*</span></label>
            <input type="text" id="edit-raca" class="form-control" placeholder="Ex: Labrador, Poodle...">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Porte <span class="text-danger">*</span></label>
            <select id="edit-porte" class="form-select">
              <option value="">Selecione...</option>
              <option value="Pequeno">Pequeno</option>
              <option value="Médio">Médio</option>
              <option value="Grande">Grande</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Tutor (Cliente) <span class="text-danger">*</span></label>
            <select id="edit-cliente_id" class="form-select">
              <option value="">Selecione...</option>
              <% clientes.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.nome %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="salvarEdicao()">Salvar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Confirmação Exclusão -->
  <div class="modal fade modal-danger" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
      <div class="modal-content">
        <div class="modal-body p-4">
          <div class="modal-confirm-header">
            <div class="modal-confirm-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <h5 style="margin:0;font-size:1rem;font-weight:700;color:#f1f5f9">Confirmar exclusão</h5>
          </div>
          <p style="margin:0;font-size:0.875rem;color:#94a3b8;line-height:1.6">Deseja realmente excluir este pet? Esta ação não pode ser desfeita.</p>
        </div>
        <div class="modal-footer border-0 pt-0 px-4 pb-4" style="gap:10px">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="flex:1">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btnConfirmarExcluir" style="flex:1">Excluir</button>
        </div>
      </div>
    </div>
  </div>

  <% if (sucesso) { %>
  <div id="toast-sucesso" class="toast-sucesso <%= sucesso === 'excluido' ? 'excluido' : '' %>">
    <div class="toast-icon">
      <i class="bi <%= sucesso === 'excluido' ? 'bi-trash-fill' : 'bi-check-circle-fill' %>"></i>
    </div>
    <span class="toast-text">
      <%= sucesso === 'criado' ? 'Pet cadastrado com sucesso!' : sucesso === 'excluido' ? 'Pet excluído com sucesso!' : 'Pet atualizado com sucesso!' %>
    </span>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let petEditandoId = null;
    let _urlExcluir = null;
    let _modal = null;

    const toast = document.getElementById('toast-sucesso');
    if (toast) setTimeout(() => {
      toast.style.transition = 'opacity 0.4s';
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 400);
    }, 3000);

    document.getElementById('modalNovoPet').addEventListener('show.bs.modal', () => {
      ['novo-nome-pet','novo-especie-pet','novo-raca-pet','novo-porte-pet','novo-cliente-pet'].forEach(id => {
        document.getElementById(id).value = '';
      });
      document.getElementById('novo-erro-pet').classList.add('d-none');
    });

    function mostrarErroPet(msg) {
      const el = document.getElementById('edit-erro-pet');
      el.textContent = msg;
      el.classList.remove('d-none');
    }

    function cadastrarPet() {
      const nome = document.getElementById('novo-nome-pet').value.trim();
      const especie = document.getElementById('novo-especie-pet').value;
      const raca = document.getElementById('novo-raca-pet').value.trim();
      const porte = document.getElementById('novo-porte-pet').value;
      const cliente_id = document.getElementById('novo-cliente-pet').value;
      const erroEl = document.getElementById('novo-erro-pet');

      erroEl.classList.add('d-none');

      const msg = !nome ? 'Informe o nome do pet.'
                : !especie ? 'Selecione a espécie.'
                : !raca ? 'Informe a raça do pet.'
                : !porte ? 'Selecione o porte do pet.'
                : !cliente_id ? 'Selecione o cliente dono do pet.'
                : null;

      if (msg) { erroEl.textContent = msg; erroEl.classList.remove('d-none'); return; }

      fetch('/pets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, especie, raca, porte, cliente_id })
      }).then(r => r.json()).then(data => {
        if (data.ok) {
          location.href = '/pets?sucesso=criado';
        } else {
          erroEl.textContent = 'Erro ao cadastrar. Tente novamente.';
          erroEl.classList.remove('d-none');
        }
      });
    }

    document.getElementById('busca-pet').addEventListener('input', function() {
      const termo = this.value.toLowerCase();
      document.querySelectorAll('#tabela-pets tbody tr').forEach(tr => {
        tr.style.display = tr.textContent.toLowerCase().includes(termo) ? '' : 'none';
      });
    });

    function abrirEditar(pet) {
      petEditandoId = pet.id;
      document.getElementById('edit-nome').value = pet.nome;
      document.getElementById('edit-especie').value = pet.especie;
      document.getElementById('edit-raca').value = pet.raca;
      document.getElementById('edit-porte').value = pet.porte;
      document.getElementById('edit-cliente_id').value = pet.cliente_id;
      document.getElementById('edit-erro-pet').classList.add('d-none');
      new bootstrap.Modal(document.getElementById('modalEditarPet')).show();
    }

    function salvarEdicao() {
      const nome = document.getElementById('edit-nome').value.trim();
      const especie = document.getElementById('edit-especie').value;
      const raca = document.getElementById('edit-raca').value.trim();
      const porte = document.getElementById('edit-porte').value;
      const cliente_id = document.getElementById('edit-cliente_id').value;

      document.getElementById('edit-erro-pet').classList.add('d-none');

      if (!nome) return mostrarErroPet('Informe o nome do pet.');
      if (!especie) return mostrarErroPet('Selecione a espécie.');
      if (!raca) return mostrarErroPet('Informe a raça do pet.');
      if (!porte) return mostrarErroPet('Selecione o porte do pet.');
      if (!cliente_id) return mostrarErroPet('Selecione o cliente dono do pet.');

      fetch(`/pets/${petEditandoId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, especie, raca, porte, cliente_id })
      }).then(r => r.json()).then(data => {
        if (data.ok) location.href = '/pets?sucesso=editado';
      });
    }

    function excluir(url) {
      _urlExcluir = url;
      _modal = new bootstrap.Modal(document.getElementById('modalConfirmar'));
      _modal.show();
    }

    document.getElementById('btnConfirmarExcluir').addEventListener('click', () => {
      if (!_urlExcluir) return;
      fetch(_urlExcluir, { method: 'DELETE' }).then(() => {
        _modal.hide();
        location.href = '/pets?sucesso=excluido';
      });
    });
  </script>

</body>
</html>
