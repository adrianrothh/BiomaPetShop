{
  "name": "biomapet",
  "version": "1.0.0",
  "description": "Sistema web de agendamento para pet shop",
  "main": "server.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --quiet server.js",
    "init-db": "node database/init.js",
    "test": "jest --verbose"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-sqlite3": "^0.9.18",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.18.1",
    "sqlite3": "^6.0.1"
  },
   "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "connect-sqlite3": {
      "sqlite3": "$sqlite3"
    }
  }
}