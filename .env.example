# Porta HTTP do servidor (opcional, padrao 3000)
PORT=3000

# Segredo usado para assinar os cookies de sessao.
# OBRIGATORIO: a aplicacao nao inicia sem esta variavel.
# Gere um valor aleatorio, nunca reutilize o exemplo abaixo e nunca versione o .env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio
# Minutos de bloqueio após muitas tentativas de login (padrão 15).
# Use 1 para demonstrações.
RATE_LIMIT_MINUTOS=15
# Senha do usuário admin@biomapet.com, usada só quando o banco é criado.
# Opcional em desenvolvimento. OBRIGATÓRIA em produção.
ADMIN_INITIAL_PASSWORD=