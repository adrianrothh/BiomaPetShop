# Porta HTTP do servidor (opcional, padrao 3000)
PORT=3000

# Segredo usado para assinar os cookies de sessao.
# OBRIGATORIO: a aplicacao nao inicia sem esta variavel.
# Gere um valor aleatorio, nunca reutilize o exemplo abaixo e nunca versione o .env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio
